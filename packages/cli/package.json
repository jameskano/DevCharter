{
  "name": "@devcharter/cli",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "devcharter": "./dist/cli.js"
  },
  "exports": {
