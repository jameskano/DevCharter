      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@devcharter/adapter-codex": "workspace:*",
    "@devcharter/core": "workspace:*"
  }
}
