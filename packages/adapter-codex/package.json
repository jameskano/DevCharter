{
  "name": "@devcharter/adapter-codex",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "build": "tsc -b tsconfig.build.json && pnpm prepare-assets",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@devcharter/core": "workspace:*",
    "jsonc-parser": "3.3.1"
  }
}
